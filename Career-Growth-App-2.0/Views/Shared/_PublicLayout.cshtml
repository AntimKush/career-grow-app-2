@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Career Growth</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css?v=@DateTime.Now.Ticks" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <style>
            /* Sticky Header */
            .career-header {
                position: sticky;
                top: 0;
                z-index: 1030;
            }

            /* Main content */
            .career-main {
                flex: 1 0 auto;
            }

            /* Footer */
            .career-footer {
                flex-shrink: 0;
            }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- HEADER -->
    <header class="career-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Career Growth
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavPublic"
                        aria-controls="mainNavPublic"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavPublic">

                    <div class="me-auto"></div>

                    <div class="d-flex">
                        <a class="btn btn-outline-light me-2"
                           asp-controller="Account"
                           asp-action="Login">
                            Sign in
                        </a>

                        <a class="btn btn-light"
                           asp-controller="Account"
                           asp-action="Register">
                            Register
                        </a>
                    </div>

                </div>
            </div>
        </nav>
    </header>


    <!-- MAIN CONTENT -->
    <main class="career-main">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>


    <!-- FOOTER -->
    <footer class="career-footer bg-dark text-light py-3">

        <div class="container d-flex justify-content-between align-items-center">

            <div>
                <strong>Career Growth</strong>

                <div class="small text-muted">
                    Connecting talent with opportunity
                </div>
            </div>

            <div class="text-end small">
                <div>
                    © @DateTime.Now.Year Career Growth
                </div>
            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/custom.js?v=@DateTime.Now.Ticks"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
