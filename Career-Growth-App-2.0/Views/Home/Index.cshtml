@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<!-- Hero -->
<section class="hero py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold mb-3">Find your next opportunity</h1>
                <p class="lead text-muted mb-4">Discover relevant jobs, learn in-demand skills and track your applications — a single portal for career growth.</p>

                <div class="search-bar p-3 rounded shadow-sm bg-white">
                    <form class="row g-2 align-items-center" asp-controller="Jobs" asp-action="Index" method="get">
                        <div class="col-md-5">
                            <input name="q" class="form-control form-control-lg" placeholder="Job title or keyword" />
                        </div>
                        <div class="col-md-4">
                            <input name="location" class="form-control form-control-lg" placeholder="City, State or Remote" />
                        </div>
                        <div class="col-md-3 d-grid">
                            <button class="btn btn-accent btn-lg" type="submit">Search jobs</button>
                        </div>
                    </form>
                    <div class="mt-2 small text-muted">Try: Software Engineer, Data Analyst, DevOps</div>
                </div>
            </div>

            <div class="col-lg-5 text-center mt-4 mt-lg-0">
                <div class="position-relative">
                    <img src="https://picsum.photos/seed/jobshero/520/320" class="img-fluid rounded shadow-sm" alt="job search" />
                    <div class="position-absolute top-0 end-0 p-2">
                        <div class="badge bg-white text-muted">Trusted Employers</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Jobs + Sidebar -->
<section class="container my-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Featured Jobs</h3>
                <a class="small text-muted" href="/Jobs">View all jobs</a>
            </div>

            <div class="row g-3">
                @for (int i = 1; i <= 6; i++)
                {
                    <div class="col-md-6">
                        <div class="card job-card p-3 fade-in-up">
                            <div class="d-flex align-items-start">
                                <div class="me-3"><i class="bi bi-briefcase-fill fs-3 text-accent"></i></div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">Senior Software Engineer</h6>
                                    <div class="small text-muted">Acme Corp • Remote • Full-time</div>
                                    <p class="mt-2 mb-0 small text-muted">Build scalable cloud services and help shape developer tooling.</p>
                                </div>
                                <div class="text-end ms-3">
                                    <div class="mb-2"><span class="badge bg-light text-muted">Urgent</span></div>
                                    <div class="d-grid gap-1">
                                        <a class="btn btn-outline-secondary btn-sm" href="/Jobs/Details/@i">View</a>
                                        <a class="btn btn-accent btn-sm" href="/Jobs/Apply/@i">Apply</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <aside class="col-lg-4">
            <div class="card mb-3 feature-card p-3">
                <h5>Why Career Growth?</h5>
                <ul class="small text-muted mb-0">
                    <li>Curated job listings from verified employers</li>
                    <li>Skill-based recommendations tailored to your profile</li>
                    <li>Application tracking and interview support</li>
                </ul>
            </div>

            <div class="card p-3 mb-3">
                <h6>Top Categories</h6>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <a class="badge bg-light text-muted" href="/Jobs?category=Engineering">Engineering</a>
                    <a class="badge bg-light text-muted" href="/Jobs?category=Data">Data Science</a>
                    <a class="badge bg-light text-muted" href="/Jobs?category=Cloud">Cloud</a>
                    <a class="badge bg-light text-muted" href="/Jobs?category=Design">Design</a>
                </div>
            </div>

            <div class="card p-3">
                <h6>Join our talent pool</h6>
                <p class="small text-muted">Get matched to jobs and receive personalized recommendations.</p>
                <a class="btn btn-outline-secondary btn-sm" href="/Account/Register">Create profile</a>
            </div>
        </aside>
    </div>
</section>

<!-- Statistics and testimonials -->
<section class="container my-5">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <div class="stat-number">1254</div>
                <div class="small text-muted">Applications</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <div class="stat-number">312</div>
                <div class="small text-muted">Hires</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <div class="stat-number">48</div>
                <div class="small text-muted">Open Roles</div>
            </div>
        </div>
    </div>
</section>

